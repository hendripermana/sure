<%# locals: (split_group:, view_ctx: "global") %>
<% parent = split_group.parent %>
<% children = split_group.children %>
<% transaction = parent.entryable %>
<% child_categories = children.filter_map { |c| c.entryable.try(:category) }.uniq %>
<% split_total = parent.amount.abs %>

<div class="split-group rounded-xl overflow-hidden"
     data-controller="split-group"
     data-split-group-id-value="<%= parent.id %>"
     data-testid="split-group-<%= parent.id %>">

  <%# ---- Parent summary header (click to expand/collapse) ---- %>
  <div class="split-group__header group flex lg:grid lg:grid-cols-12 items-center gap-3 lg:gap-4 p-3 lg:p-4 cursor-pointer select-none hover:bg-surface-hover transition-colors"
       role="button"
       tabindex="0"
       aria-expanded="true"
       data-split-group-target="header"
       data-action="click->split-group#toggle keydown.enter->split-group#toggle keydown.space->split-group#toggle">

    <div class="flex items-center gap-2 lg:gap-3 col-span-8 min-w-0">
      <span class="shrink-0 text-secondary transition-transform duration-200" data-split-group-target="chevron">
        <%= icon "chevron-down", size: "sm", color: "current" %>
      </span>

      <div class="hidden lg:flex shrink-0">
        <% if transaction.merchant&.logo_url.present? %>
          <%= image_tag transaction.merchant.logo_url, class: "w-9 h-9 rounded-full border border-secondary", loading: "lazy" %>
        <% else %>
          <%= render DS::FilledIcon.new(variant: :text, text: parent.name, size: "lg", rounded: true) %>
        <% end %>
      </div>

      <div class="min-w-0">
        <div class="flex items-center gap-2 min-w-0">
          <span class="font-semibold text-primary truncate"><%= parent.name %></span>
          <span class="inline-flex items-center gap-1 shrink-0 text-xs font-semibold rounded-full px-2 py-0.5 bg-surface-inset text-primary border border-secondary">
            <%= icon "split", size: "sm", color: "current" %>
            <%= t("transactions.split_group.split_badge") %> · <%= children.size %>
          </span>
        </div>

        <div class="text-secondary text-xs mt-1 min-w-0">
          <%# Desktop: account subtitle (category preview lives in the category column) %>
          <span class="hidden md:inline truncate">
            <% if transaction.merchant&.present? %><%= transaction.merchant.name %> • <% end %><%= parent.account.name %>
          </span>
          <%# Mobile: category preview (category column is hidden on small screens) %>
          <span class="md:hidden flex items-center gap-x-2 gap-y-1 flex-wrap">
            <% if child_categories.any? %>
              <% child_categories.first(4).each do |cat| %>
                <span class="inline-flex items-center gap-1 min-w-0">
                  <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= sanitize_category_color(cat.color) %>"></span>
                  <span class="truncate"><%= cat.name %></span>
                </span>
              <% end %>
            <% else %>
              <span><%= t("transactions.split_group.across_categories", count: children.size) %></span>
            <% end %>
          </span>
        </div>
      </div>
    </div>

    <%# Category column: stacked mini-badges of the child categories (desktop) %>
    <div class="hidden md:flex col-span-2 items-center">
      <% if child_categories.any? %>
        <div class="flex items-center -space-x-2">
          <% child_categories.first(3).each do |cat| %>
            <% c = sanitize_category_color(cat.color) %>
            <span class="w-7 h-7 rounded-full border-2 border-container flex items-center justify-center shrink-0"
                  style="background-color: color-mix(in oklab, <%= c %> 15%, transparent); color: <%= c %>;"
                  title="<%= cat.name %>">
              <%= icon (cat.lucide_icon.presence || "circle-dashed"), size: "sm", color: "current" %>
            </span>
          <% end %>
          <% if child_categories.size > 3 %>
            <span class="w-7 h-7 rounded-full border-2 border-container flex items-center justify-center shrink-0 bg-surface-inset text-secondary text-xs font-semibold"
                  title="+<%= child_categories.size - 3 %>">
              +<%= child_categories.size - 3 %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="shrink-0 col-span-4 lg:col-span-2 ml-auto flex items-center justify-end gap-1.5">
      <span class="text-secondary font-medium privacy-sensitive"
            title="<%= t("transactions.split_group.excluded_tooltip") %>">
        <%= format_money(-parent.amount_money) %>
      </span>

      <%# Always-visible actions menu (works on touch, unlike hover) %>
      <div data-action="click->split-group#stop">
        <%= render DS::Menu.new(variant: :icon, testid: "split-group-menu-#{parent.id}") do |menu| %>
          <% menu.with_item(
                variant: :link,
                text: t("transactions.split_group.edit_splits"),
                icon: "pencil",
                href: edit_transaction_split_path(parent),
                frame: :modal) %>
          <% menu.with_item(
                variant: :button,
                text: t("transactions.split_group.unsplit"),
                icon: "git-merge",
                href: transaction_split_path(parent),
                method: :delete,
                data: { turbo_confirm: t("transactions.split_group.unsplit_confirm") }) %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ---- Proportional category bar (always visible) ---- %>
  <div class="px-3 lg:px-4 pb-3">
    <div class="flex h-1.5 w-full rounded-full overflow-hidden bg-surface-inset gap-0.5">
      <% children.each do |child_entry| %>
        <% pct = split_total.zero? ? 0 : (child_entry.amount.abs.to_f / split_total.to_f * 100) %>
        <% bar_color = sanitize_category_color(child_entry.entryable.try(:category)&.color || "#737373") %>
        <div class="h-full first:rounded-l-full last:rounded-r-full"
             style="width: <%= pct.round(2) %>%; background-color: <%= bar_color %>;"
             title="<%= child_entry.entryable.try(:category)&.name || child_entry.name %> · <%= pct.round %>%"></div>
      <% end %>
    </div>
  </div>

  <%# ---- Children (connected, collapsible) ---- %>
  <div class="split-group__children" data-split-group-target="children">
    <div class="ml-6 lg:ml-9 border-l border-dashed border-secondary">
      <% children.each do |child_entry| %>
        <% if child_entry.entryable.present? %>
          <% share = parent.amount.abs.zero? ? nil : (child_entry.amount.abs.to_f / parent.amount.abs.to_f * 100).round %>
          <%= render partial: child_entry.entryable.to_partial_path,
                    locals: { entry: child_entry, in_split_group: true, view_ctx: view_ctx, split_share: share } %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
